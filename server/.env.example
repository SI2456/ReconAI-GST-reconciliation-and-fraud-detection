# ==============================================================================
# ReconAI Server Environment Configuration
# Copy this file to .env and configure your database & services.
# ==============================================================================

APP_NAME=ReconAI API
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=4000
CLIENT_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql+psycopg://reconai:reconai@localhost:5432/reconai
# Optional SQLite fallback for quick offline testing:
# DATABASE_URL=sqlite:///./server/data/reconai-dev.sqlite3
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Dev-only value. With ENVIRONMENT=production the server refuses to start until this is
# replaced: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=reconai-development-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ------------------------------------------------------------------------------
# 4. CLOUD STORAGE (Cloudflare R2 / S3 - Optional)
# ------------------------------------------------------------------------------
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=reconai-documents

# ------------------------------------------------------------------------------
# 5. EMAIL / SMTP (Optional - OTP is printed in the server terminal if left blank)
# ------------------------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@reconai.local

# ------------------------------------------------------------------------------
# 6. EXTERNAL APIS & OCR
# ------------------------------------------------------------------------------
GSTVERIFY_API_KEY=
GSTVERIFY_BASE_URL=https://api.gstverify.dubey.app/api/v1

# Optional: enables the "Google Gemini" engine for re-running AI extraction on invoices.
GEMINI_API_KEY=

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
